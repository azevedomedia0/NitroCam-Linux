# Example Flathub manifests (not used by local build.sh)
#
# Flathub rejects local `path:` sources. Use one of:
#   A) Source build from a public git tag (requires redistributable Linux tree)
#   B) extra-data binary release with URL + sha256 (common for proprietary apps)
#
# Flutter SDK sha256 for 3.35.5-stable:
#   8eead69e5d84131fcfbb2cfd44164c00e9a04df725f24672ea234c6bd136353d

# --- Option A: source build -------------------------------------------------
app-id: com.azevedomedia.NitroCam
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: nitrocam
finish-args:
  # Network: WebRTC + WS signaling; IPC: X11; Wayland + Pulse; PipeWire camera path
  - --share=network
  - --share=ipc
  - --socket=fallback-x11
  - --socket=wayland
  - --socket=pulseaudio
  # /dev/video* (v4l2loopback) + USB enumeration — Flathub may ask for justification
  - --device=all
  - --filesystem=xdg-run/pipewire-0
  - --filesystem=/var/run/usbmuxd:ro
  - --talk-name=org.freedesktop.Avahi
modules:
  - name: flutter-sdk
    buildsystem: simple
    build-commands:
      - cp -a . /app/flutter-sdk
    sources:
      - type: archive
        url: https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.35.5-stable.tar.xz
        sha256: 8eead69e5d84131fcfbb2cfd44164c00e9a04df725f24672ea234c6bd136353d
  - name: nitrocam
    buildsystem: simple
    build-options:
      build-args:
        - --share=network
      env:
        PATH: /app/flutter-sdk/bin:/usr/bin:/bin
        PUB_CACHE: /run/build/nitrocam/.pub-cache
    build-commands:
      - flutter config --enable-linux-desktop --no-analytics
      - flutter pub get
      - flutter build linux --release
      - install -D build/linux/x64/release/bundle/nitrocam /app/nitrocam
      - cp -a build/linux/x64/release/bundle/lib /app/
      - cp -a build/linux/x64/release/bundle/data /app/
      - install -d /app/bin
      - printf '%s\n' '#!/bin/sh' 'exec /app/nitrocam "$@"' > /app/bin/nitrocam
      - chmod 755 /app/bin/nitrocam
      - install -D flathub/com.azevedomedia.NitroCam.desktop /app/share/applications/com.azevedomedia.NitroCam.desktop
      - install -D flathub/com.azevedomedia.NitroCam.metainfo.xml /app/share/metainfo/com.azevedomedia.NitroCam.metainfo.xml
      - install -D flathub/icons/hicolor/256x256/apps/com.azevedomedia.NitroCam.png /app/share/icons/hicolor/256x256/apps/com.azevedomedia.NitroCam.png
    sources:
      - type: git
        url: https://github.com/azevedomedia0/NitroCam-Linux.git
        tag: v1.0.0
        commit: REPLACE_WITH_COMMIT

